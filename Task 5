#include <stdio.h>

int main() {
    int image[4][4];
    int result[4][4];
    int brightness_amount;
    int threshold;

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            scanf("%d", &image[i][j]);
        }
    }
    scanf("%d", &brightness_amount);
    scanf("%d", &threshold);

    printf("Original image:\n");
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            printf("%d\t", image[i][j]);
        }
        printf("\n");
    }

    printf("\nBrightness (%+d):\n", brightness_amount);
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            int val = image[i][j] + brightness_amount;
            if (val > 255) {
                val = 255;
            }
            if (val < 0) {
                val = 0;
            }
            printf("%d\t", val);
        }
        printf("\n");
    }

    printf("\nBlack and white (threshold %d):\n", threshold);
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            if (image[i][j] >= threshold) {
                printf("255\t");
            } else {
                printf("0\t");
            }
        }
        printf("\n");
    }

    printf("\nHorizontally flipped:\n");
    for (int i = 0; i < 4; i++) {
        for (int j = 3; j >= 0; j--) {
            printf("%d\t", image[i][j]);
        }
        printf("\n");
    }

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            result[i][j] = image[i][j];
        }
    }

    for (int i = 1; i < 3; i++) {
        for (int j = 1; j < 3; j++) {
            int sum = 0;
            sum += image[i-1][j-1] + image[i-1][j] + image[i-1][j+1];
            sum += image[i][j-1]   + image[i][j]   + image[i][j+1];
            sum += image[i+1][j-1] + image[i+1][j] + image[i+1][j+1];
            result[i][j] = sum / 9;
        }
    }

    printf("\nSmoothed image:\n");
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            printf("%d\t", result[i][j]);
        }
        printf("\n");
    }

    return 0;
}
